{
  "compilerOptions": {
    "target": "ES2023",
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "lib": ["ES2023", "DOM", "DOM.Iterable"],
    "jsx": "react-jsx",
    "strict": true,
    "noEmit": true,
    "allowImportingTsExtensions": true,
    "esModuleInterop": true,
    "skipLibCheck": true,
    "types": ["node", "vite/client"],
    "resolveJsonModule": true
  },
  "include": ["apps", "packages", "tooling", "tests", "vitest.config.ts", "vitest.workers.config.ts", "playwright.config.ts"],
  "exclude": ["node_modules", ".agents", "tooling/oxlint", "templates"]
}
