# Default local development uses simulation and zero paid dispatch.
ARTI_DATA_ROOT=.arti
ARTI_AUTOTICK_MS=2000

# Configure Cloudflare Worker vars/secrets using the deployment runbook.
# Never put API tokens, Access JWTs or credentials in committed files.

# Opt-in real GLM development: pnpm dev:glm
# Private configuration: .arti/local-glm.json; see tooling/features/local-glm/README.md.
# ARTI_LOCAL_GLM_CONFIG=.arti/local-glm.json
# CLOUDFLARE_API_TOKEN is supplied privately, or use the existing Wrangler login.
