{
  "name": "arti",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "tsx tooling/dev.ts",
    "build": "tsx tooling/cloud-catalogue.ts && vite build --config apps/console/vite.config.ts && tsx apps/knowledge/features/publication/build.ts",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:e2e": "playwright test",
    "lint": "oxlint .",
    "catalog:check": "tsx tooling/catalog.ts",
    "check": "pnpm typecheck && pnpm test && pnpm catalog:check && pnpm build",
    "test:workers": "vitest run --config vitest.workers.config.ts",
    "agent:token": "tsx tooling/agent-token.ts",
    "backup": "tsx tooling/backup.ts",
    "staging": "tsx tooling/staging/cli.ts",
    "evaluations": "tsx tooling/evaluations/cli.ts",
    "walkthrough": "tsx tooling/cloud-catalogue.ts && tsx tooling/walkthrough.ts",
    "test:execution-workers": "vitest run --config apps/execution/vitest.workers.config.ts",
    "staging:smoke": "tsx tooling/staging/smoke.ts",
    "dev:glm": "tsx tooling/dev.ts --local-glm"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "1.30.0",
    "agents": "^0.28.0",
    "jose": "^6.2.12",
    "react": "^19.3.0",
    "react-dom": "^19.3.0",
    "zod": "^4.6.5"
  },
  "devDependencies": {
    "@cloudflare/vitest-plugin": "^1.4.0",
    "@cloudflare/workers-types": "^5.20261011.1",
    "@oxlint/plugins": "1.87.0",
    "@playwright/test": "^1.64.0",
    "@types/node": "^26.6.5",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.1.2",
    "oxlint": "1.87.0",
    "tldts": "7.4.18",
    "tsx": "^4.23.15",
    "typescript": "^7.0.2",
    "vite": "^8.3.4",
    "vitest": "^4.1.0",
    "wrangler": "^4.149.0"
  },
  "packageManager": "pnpm@12.4.1"
}
